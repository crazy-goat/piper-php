{
    "name": "crazy-goat/piper-php",
    "description": "Text-to-speech in PHP using Piper via FFI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\PiperTTS\\": "src/"
        }
    },
    "bin": [
        "bin/piper-tts"
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.27",
        "phpstan/phpstan": "2.1.45",
        "phpunit/phpunit": "10.5.63",
        "rector/rector": "2.3.9"
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "lint:fix": "bin/lint.sh --fix",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "vendor/bin/phpunit --testsuite unit",
        "test:all": "vendor/bin/phpunit"
    },
    "config": {
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    }
}
